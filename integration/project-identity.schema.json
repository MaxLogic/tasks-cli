{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared tasks project identity",
  "type": "object",
  "required": ["project_id"],
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
